#!/bin/bash
# =============================================
# Project Dump v3.6 — исправлены синтаксические ошибки
# =============================================

export LC_ALL=C.UTF-8
export LANG=C.UTF-8

OUTPUT="project_dump.txt"
ERROR_LOG="encoding_errors.log"
MAX_SIZE=524288  # 500 КБ

> "$OUTPUT"
> "$ERROR_LOG"

echo "### PROJECT TREE ###" | tee -a "$OUTPUT"
tree -a -I '.git|node_modules|dist|build|.idea|.vscode|bin|obj|__pycache__' | tee -a "$OUTPUT" || echo "tree не найден"

echo -e "\n\n### FILE CONTENTS ###" | tee -a "$OUTPUT"

find . -type f \
  -not -path '*/.git/*' \
  -not -path '*/node_modules/*' \
  -not -path '*/dist/*' \
  -not -path '*/build/*' \
  -not -path '*/__pycache__/*' \
  -size -2M \
  \( -name "*.yml" -o -name "*.yaml" -o -name "*.json" \
   -o -name "*.ps1" -o -name "*.sh" -o -name "*.py" \
   -o -name "*.xml" -o -name "*.conf" \
   -o -name "*.ini" -o -name "*.md" -o -name "*.js" \
   -o -name "*.ts" -o -name "*.html" -o -name "*.css" \
   -o -name "*.txt" \) \
  -print0 | while IFS= read -r -d '' file; do

    printf '\n\n===== FILE: %s =====\n' "$file" | tee -a "$OUTPUT"

    # Проверка на бинарный файл
    if [ -s "$file" ] && head -c 10000 "$file" | grep -q $'\0'; then
        null_count=$(head -c 50000 "$file" | tr -cd '\0' | wc -c)
        if [ "$null_count" -gt 5 ]; then
            if head -c 2 "$file" | grep -q $'\xff\xfe'; then
                echo "[Detected UTF-16LE]" | tee -a "$OUTPUT"
                iconv -f UTF-16LE -t UTF-8//IGNORE "$file" 2>>"$ERROR_LOG" | head -c "$MAX_SIZE" >> "$OUTPUT"
            else
                echo "[Binary file skipped]" | tee -a "$OUTPUT"
            fi
            continue
        fi
    fi

    # Основная обработка текстового файла
    if command -v iconv >/dev/null; then
        iconv -f UTF-8 -t UTF-8//IGNORE "$file" 2>>"$ERROR_LOG" | head -c "$MAX_SIZE" >> "$OUTPUT"
    else
        head -c "$MAX_SIZE" "$file" >> "$OUTPUT"
    fi

    # Предупреждение об обрезке (без восклицательных знаков)
    if [ "$(wc -c < "$file")" -gt "$MAX_SIZE" ]; then
        echo -e "\n[FILE TRUNCATED - showing first 500 KB only]" >> "$OUTPUT"
    fi

done

echo -e "\n\n=== Дамп завершён ===" | tee -a "$OUTPUT"
echo "Создан файл: $OUTPUT"
echo "Лог ошибок: $ERROR_LOG"
